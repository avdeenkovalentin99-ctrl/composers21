{
  "name": "composersxxi",
  "version": "1.0.0",
  "description": "Festival website scaffold",
  "scripts": {
    "dev": "vite",
    "fix:utf8": "tsc ./scripts/fix-utf8.ts --module NodeNext --target ES2022 --outDir .tmp-build --skipLibCheck --ignoreConfig && node ./.tmp-build/fix-utf8.js",
    "check:utf8": "node scripts/check-encoding.js",
    "check:encoding": "node scripts/check-encoding.js",
    "import:composers": "node ./scripts/import-composers.mjs",
    "build:bios": "tsc ./scripts/build-bios.ts --allowJs --module NodeNext --target ES2022 --outDir .tmp-build --skipLibCheck --ignoreConfig && node ./.tmp-build/build-bios.js",
    "test:bios": "tsc ./scripts/biography-quality.test.ts --module NodeNext --target ES2022 --outDir .tmp-build --skipLibCheck --ignoreConfig && node --test .tmp-build/biography-quality.test.js scripts/composer-biography.test.mjs",
    "test:encoding": "node --test scripts/check-encoding.test.js",
    "test": "npm run test:encoding && npm run test:bios && node --test scripts/media-syncopation.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "assets:build": "python scripts/optimize-assets.py",
    "build": "npm run check:utf8 && tsc -b && vite build",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.5"
  }
}
